PROJECT_NAME="FaceAttend AI"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
# For PostgreSQL (Docker or local):
DATABASE_URL="postgresql://faceattend_user:faceattend_pass@localhost:5432/faceattend_db"
# If PostgreSQL is not running, backend seamlessly falls back to: sqlite:///./faceattend.db

# Security & Authentication
JWT_SECRET="faceattend_production_grade_jwt_secret_key_change_in_production_987654321"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Face Recognition Settings
FACE_MATCH_THRESHOLD=0.65
ATTENDANCE_COOLDOWN_SECONDS=60

# Organization Attendance Timing
WORK_START_TIME="09:30"
WORK_END_TIME="17:00"

# AI / RAG Configuration
EMBEDDING_MODEL="all-MiniLM-L6-v2"
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# CORS Configuration
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:80"
